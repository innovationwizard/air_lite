# AI Refill Lite — Environment Variables
# Copy to .env.local (frontend) and .env (ml) for local development
# Never commit actual .env files

# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example...
SUPABASE_SECRET_KEY=sb_secret_example...

# ─── Railway ML Service ───────────────────────────────────────────────────────
# URL of the Railway-deployed Python backtest engine
ML_SERVICE_URL=http://localhost:5000

# Shared secret for authenticating requests between Next.js and Railway
ML_SERVICE_API_KEY=apikeyexample...

# ─── Supabase (for Railway ML service to write results back) ──────────────────
# Same Supabase credentials, used by the Python service
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_example...
