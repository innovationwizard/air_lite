# Frontend environment variables
# Copy to .env.local for local development — never commit .env.local

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example...

# Railway ML service (server-side only, not NEXT_PUBLIC_)
ML_SERVICE_URL=http://localhost:5000
ML_SERVICE_API_KEY=your-shared-secret
SUPABASE_SECRET_KEY=sb_secret_example...

# Bug-report widget (server-side only) — Resend notification channel.
# BUG_REPORT_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=re_example...
BUG_REPORT_FROM=bot@example.com
BUG_REPORT_TO=jorgeluiscontrerasherrera@gmail.com,analistacomercial@suplicentro.com.gt
